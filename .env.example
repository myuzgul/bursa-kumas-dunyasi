NODE_ENV=development
PORT=3000

# Güvenlik & JWT
JWT_SECRET=bursa-kumas-dunyasi-super-secure-production-secret-2026-key

# PayTR Ödeme Entegrasyonu
PAYTR_MERCHANT_ID=123456
PAYTR_MERCHANT_KEY=test_merchant_key_2026
